function generateTestTasks(subject, grade, topicIndex) {
  const key = (subject === 'math' ? 'm' : 'r') + grade + '_' + (topicIndex + 1);
  let rawPool = [];
  if (taskGenerators[key]) rawPool = taskGenerators[key]();
  if (!rawPool || rawPool.length === 0) {
    const base = curriculum[subject][grade][topicIndex].tasks || [];
    rawPool = shuffle(base);
  } else {
    rawPool = shuffle(rawPool);
  }
  return rawPool.slice(0, 12);
}

