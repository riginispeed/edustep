<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0b1220">
<title>EduStep — интерактивная учебная платформа</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{--bg:#0b1220;--panel:#121e30;--panel2:#1a2a40;--text:#f4f7fb;--muted:#a8b6c9;--blue:#69aefc;--green:#26c281;--red:#f06470;--line:#2a3b52}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{margin:0;background:radial-gradient(ellipse at top,#182a43 0%,var(--bg) 58%);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;min-height:100vh}

button, .logo, .subject-card, .grade, .topic-btn, .nav-back, .pill {
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
}

button, input, textarea, select{font:inherit}
.wrap{width:min(1120px,100%);margin:auto;padding: max(14px,env(safe-area-inset-top)) 15px max(34px,env(safe-area-inset-bottom))}
header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:4px 0 20px}

.logo{
  font-size:23px;
  font-weight:900;
  letter-spacing:-.8px;
  cursor:pointer;
  background: var(--panel);
  border: 1px solid var(--line);
  padding: 8px 16px;
  border-radius: 14px;
  transition: all 0.25s ease;
  display: inline-block;
}
.logo span{color:var(--blue)}
.logo:hover{
  border-color: var(--blue);
  background: var(--panel2);
  transform: translateY(-1px);
}

.header-right{display:flex;align-items:center;gap:10px}
.pill{font-size:12px;color:#9ee7c7;background:#173d35;border:1px solid #27614e;border-radius:99px;padding:6px 10px;white-space:nowrap}

.hero{padding:22px 20px;border:1px solid #2a405b;border-radius:22px;background:linear-gradient(135deg,#1b3554,#142239 65%,#17283e);margin-bottom:20px;box-shadow:0 8px 25px rgba(0,0,0,0.2)}.eyebrow{color:#9dcaff;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:1.1px}h1{font-size:clamp(25px,5vw,36px);line-height:1.08;margin:9px 0}.sub{color:#c0cde0;line-height:1.55;margin:0;font-size:14px}

.screen {
  animation: fadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px) scale(0.99); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.subjects-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin-top:15px}
.subject-card{background:var(--panel);border:2px solid var(--line);border-radius:20px;padding:24px;text-align:center;cursor:pointer;transition:all .25s ease;display:block;width:100%}
.subject-card:hover{border-color:var(--blue);background:var(--panel2);transform:translateY(-4px);box-shadow:0 10px 20px rgba(0,0,0,0.3)}
.subject-card:active{transform:scale(.97)}
.subject-card h2{margin:10px 0 5px;font-size:22px;color:var(--text)}
.subject-card p{color:var(--muted);font-size:13px;margin:0}
.subject-icon{font-size:28px;font-weight:bold;color:var(--blue);margin-bottom:6px;transition:transform 0.3s ease}
.subject-card:hover .subject-icon{transform:scale(1.15)}

.section-title{font-size:18px;font-weight:800;margin:21px 2px 11px}
.grades{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.grade{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:15px;padding:15px 5px;text-align:center;font-size:14px;font-weight:700;cursor:pointer;transition:all 0.2s ease}
.grade b{display:block;font-size:24px;color:#a9d1ff;margin-bottom:2px;transition:color 0.2s ease}
.grade:hover{border-color:var(--blue);background:var(--panel2);transform:translateY(-2px)}
.grade:hover b{color:var(--blue)}
.grade:active{transform:scale(.95)}

.topic-list{display:grid;grid-template-columns:1fr;gap:10px}
.topic-btn{text-align:left;border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:16px;padding:16px 18px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;transition:all .2s ease;width:100%}
.topic-btn:hover{border-color:var(--blue);background:var(--panel2);transform:translateX(4px)}
.topic-btn:active{transform:scale(.98)}
.topic-info .topic-number{font-size:11px;color:#9dcaff;font-weight:800;letter-spacing:.5px;text-transform:uppercase}
.topic-info strong{display:block;font-size:16px;line-height:1.3;margin-top:4px}
.topic-arrow{font-size:18px;color:var(--blue);font-weight:800;transition:transform 0.2s ease}
.topic-btn:hover .topic-arrow{transform:translateX(4px)}

.nav-back{background:none;border:none;color:var(--blue);font-weight:700;font-size:14px;cursor:pointer;padding:0;display:inline-flex;align-items:center;gap:6px;margin-bottom:15px;transition:all 0.2s ease}
.nav-back:hover{opacity:0.8;transform:translateX(-3px)}

.card{background:rgba(18,30,48,.96);border:1px solid var(--line);border-radius:20px;padding:20px;margin-top:15px;box-shadow:0 12px 30px rgba(0,0,0,0.25)}
.muted{color:var(--muted);font-size:13px}
.lesson-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.topic-title{font-size:22px;line-height:1.2;font-weight:850;margin:8px 0 12px}

.theory-container {margin-bottom: 15px;}
.theory-toggle-btn {background: var(--panel2);border: 1px solid var(--line);color: var(--blue);border-radius: 12px;padding: 10px 16px;font-weight: 700;font-size: 13px;cursor: pointer;transition: all 0.2s ease;display: inline-flex;align-items: center;gap: 6px;width: 100%;justify-content: center;}
.theory-toggle-btn:hover {border-color: var(--blue);background: #1d3350;}
.theory-dropdown {max-height: 0;overflow: hidden;transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;opacity: 0;}
.theory-dropdown.open {max-height: 500px;opacity: 1;}
.theory-block {background:#142337;border:1px solid #233956;border-radius:16px;padding:16px 18px;margin-top: 10px;}
.theory-block h3 {margin:0 0 8px 0;font-size:15px;color:var(--blue);}
.theory{color:#d3deec;font-size:14px;line-height:1.6;margin:0}

.example{background:#10263a;border:1px solid #2a4965;border-radius:14px;padding:14px 16px;margin-top:10px}
.example-label{font-size:11px;color:#9dcaff;font-weight:850;letter-spacing:.7px;text-transform:uppercase}
.example p{font-size:14px;line-height:1.55;margin:6px 0 0;color:#e5edf7}
.progress{height:8px;background:#293b52;border-radius:20px;overflow:hidden;margin:20px 0 5px}
.progress>div{height:100%;background:linear-gradient(90deg,#5ca8ff,#42d49b);width:0%;transition:width 0.4s cubic-bezier(0.1, 0.9, 0.2, 1)}

.task{padding:16px 0;border-bottom:1px solid #26364b;transition:all 0.2s ease}
.task:last-child{border-bottom:0;padding-bottom:2px}
.task-head{display:flex;gap:12px;align-items:flex-start}
.num{flex:0 0 28px;height:28px;border-radius:99px;background:#243b58;color:#a9d1ff;display:grid;place-items:center;font-weight:800;font-size:13px}
.question{font-weight:650;line-height:1.45;padding-top:3px;font-size:14px}
.answer{margin:11px 0 0 40px}
.answer input{width:100%;min-width:0;background:#0c1727;border:1px solid #344861;border-radius:11px;padding:12px 14px;color:white;font-size:16px;outline:none;transition:all 0.2s ease}
.answer input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #69aefc20}
.answer input.correct{border-color:var(--green);background:#123329}
.answer input.wrong{border-color:var(--red);background:#391f2a;animation:shake 0.3s ease}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-4px); }
  40%, 80% { transform: translateX(4px); }
}

.feedback{font-size:12px;margin:7px 0 0 40px;line-height:1.45;color:var(--muted);animation:fadeIn 0.25s ease}
.feedback.good{color:#58dfa6}
.feedback.bad{color:#ff8991}

.actions{display:flex;gap:10px;margin-top:20px}
.primary,.secondary{border:0;border-radius:13px;padding:13px 18px;font-weight:800;cursor:pointer;min-height:48px;transition:all 0.2s ease;display:flex;align-items:center;justify-content:center;gap:6px}
.primary{background:linear-gradient(135deg,#75b9ff,#4e96f0);color:#071426;flex:1}
.primary:hover{opacity:0.92;transform:translateY(-1px)}
.secondary{background:#25364c;color:#dce8f7}
.secondary:hover{background:#2e435e}
.secondary:active{transform:scale(.98)}
.secondary:disabled {opacity: 0.4;cursor: not-allowed;}

.result{display:none;margin-top:18px;padding:16px;border-radius:14px;background:#172b40;border:1px solid #34516d;animation:fadeIn 0.3s ease}
.result.show{display:block}
.result strong{font-size:22px}
.result p{color:#c0cde0;margin:6px 0 0;font-size:13px;line-height:1.5}

.note{font-size:12px;color:#8294aa;text-align:center;margin:22px 8px 4px;line-height:1.5}

.author-credits {font-size: 12px;font-weight: 500;color: var(--muted);text-align: center;margin-bottom: 5px;opacity: 0.7;}

.footer-container {text-align: center;margin-top: 25px;}

.hidden{display:none!important}

.frac {display:inline-flex;vertical-align:middle;flex-direction:column;text-align:center;font-size:0.9em;padding:0 4px}
.frac .num {border-bottom:1.5px solid currentColor;padding:0 2px 1px 2px;background:transparent;color:inherit;border-radius:0;height:auto;width:auto;display:block}
.frac .den {padding:1px 2px 0 2px;display:block}

/* ===== Конструктор тестов ===== */
.creator-label{font-size:13px;color:#b8c9dc;font-weight:700;display:block;margin-top:6px}
.creator-input, .creator-textarea, .creator-select{width:100%;padding:12px;background:#0c1727;color:white;border:1px solid #344861;border-radius:10px;margin:5px 0 12px}
.creator-textarea{resize:vertical;min-height:75px}
.q-editor{background:#142337;border:1px solid var(--line);border-radius:14px;padding:14px;margin:12px 0}
.q-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}
.q-options{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.q-danger{border:0;border-radius:12px;padding:8px 14px;font-weight:800;cursor:pointer;background:#492530;color:#ffb8c2}
.creator-error{color:#ff8991;font-size:13px;min-height:18px;margin:6px 0}
.qr-wrap{background:white;color:#111;border-radius:15px;padding:18px;text-align:center;width:max-content;max-width:100%;margin:15px auto}
#qrcode{display:flex;justify-content:center}
#qrcode img,#qrcode canvas{max-width:100%;height:auto}
.share-url{overflow-wrap:anywhere;background:#0c1727;border-radius:10px;padding:12px;font-size:12px;color:#b9d7fa;margin-bottom:10px}

.student-option{display:flex;gap:10px;align-items:center;padding:12px;background:#0c1727;border:1px solid var(--line);border-radius:10px;margin:8px 0}
.student-option input{width:auto;margin:0}
.student-text{width:100%;padding:12px;background:#0c1727;color:white;border:1px solid #344861;border-radius:10px;margin:8px 0}

@media(min-width:960px){
  #questionEditors{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start}
  #questionEditors .q-editor{margin:0}
}

@media(max-width:600px){
  .wrap{padding-left:12px;padding-right:12px}
  .hero{padding:19px 16px}
  .subjects-grid{grid-template-columns:1fr}
  .card{padding:14px}
  .topic-title{font-size:19px}
  .q-options{grid-template-columns:1fr}
  .grades{grid-template-columns:repeat(3,minmax(0,1fr))}
}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div class="logo" id="homeLogo">Edu<span>Step</span></div>
  <div class="header-right">
    <div class="pill" id="userBadge">Пройдено тестов: 0</div>
  </div>
</header>

<div id="screenHome" class="screen">
  <section class="hero">
    <div class="eyebrow">Твоя учебная платформа</div>
    <h1>Учись и проверяй<br>свои знания</h1>
    <p class="sub">Выбери предмет, чтобы начать пошаговое обучение. Тебя ждут подробные разборы теории, наглядные примеры и динамические тесты с автоматической генерацией новых заданий.</p>
  </section>
  <div class="section-title">Выбери предмет</div>
  <div class="subjects-grid">
    <button type="button" class="subject-card" onclick="window.selectSubject('math')">
      <div class="subject-icon">📐</div>
      <h2>Математика</h2>
      <p>Арифметика, уравнения, дроби, геометрия и проценты с 1 по 5 класс.</p>
    </button>
    <button type="button" class="subject-card" onclick="window.selectSubject('rus')">
      <div class="subject-icon">📚</div>
      <h2>Русский язык</h2>
      <p>Орфография, пунктуация, морфология, части речи и фразеология.</p>
    </button>
  </div>

  <div class="card">
    <h2 style="margin:0 0 6px;font-size:19px">🧑‍🏫 Создать свой тест</h2>
    <p class="muted" style="margin:0 0 12px">Составь собственные задания и поделись тестом с учениками через QR-код или ссылку.</p>
    <button type="button" class="primary" style="width:100%" onclick="window.openCreator()">＋ Создать тест</button>
  </div>
</div>

<div id="screenGrades" class="screen hidden">
  <button type="button" class="nav-back" onclick="window.goToHome()">← Назад к предметам</button>
  <section class="hero">
    <div class="eyebrow" id="gradesHeroSub">Математика</div>
    <h1>Выбери класс</h1>
    <p class="sub">Нажми на свой класс, чтобы открыть список доступных тем для изучения.</p>
  </section>
  <div class="grades">
    <button type="button" class="grade" onclick="window.selectGrade(1)"><b>1</b>класс</button>
    <button type="button" class="grade" onclick="window.selectGrade(2)"><b>2</b>класс</button>
    <button type="button" class="grade" onclick="window.selectGrade(3)"><b>3</b>класс</button>
    <button type="button" class="grade" onclick="window.selectGrade(4)"><b>4</b>класс</button>
    <button type="button" class="grade" onclick="window.selectGrade(5)"><b>5</b>класс</button>
  </div>
</div>

<div id="screenTopics" class="screen hidden">
  <button type="button" class="nav-back" onclick="window.goToGrades()">← Назад к классам</button>
  <section class="hero">
    <div class="eyebrow" id="topicsHeroSub">Математика · 1 класс</div>
    <h1>Выбери тему</h1>
    <p class="sub">Изучи глубокую теорию и переходи к решению обновляемого тренажёра.</p>
  </section>
  <div class="topic-list" id="topicListContainer"></div>
</div>

<div id="screenLesson" class="screen hidden">
  <button type="button" class="nav-back" onclick="window.goToTopics()">← Назад к списку тем</button>
  <section class="card" id="lesson" aria-live="polite">
   <div class="lesson-head">
     <span class="muted" id="gradeLabel">1 класс · Математика</span>
     <span class="muted" id="countLabel">12 заданий</span>
   </div>
   <div class="topic-title" id="topicTitle"></div>
   
   <div class="theory-container">
     <button type="button" class="theory-toggle-btn" id="theoryToggleBtn">Подробнее (Теория и правила)</button>
     <div class="theory-dropdown" id="theoryDropdown">
       <div class="theory-block">
         <h3>Теоретический материал и правила</h3>
         <p class="theory" id="theory"></p>
       </div>
     </div>
   </div>
   
   <div class="example">
     <div class="example-label">Наглядный пример решения</div>
     <p id="example"></p>
   </div>

   <div class="progress" aria-label="Результат"><div id="progressBar"></div></div>
   <div id="tasks"></div>
   <div class="actions">
     <button type="button" class="primary" id="checkBtn">Проверить ответы</button>
     <button type="button" class="secondary" id="resetBtn">🔄 Новые задания (Сброс)</button>
   </div>
   <div class="result" id="result" aria-live="polite">
     <div class="lesson-head"><strong id="score">0 из 12</strong><span id="percent" class="pill">0%</span></div>
     <p id="resultText"></p>
   </div>
  </section>
</div>

<div id="screenCreator" class="screen hidden">
  <button type="button" class="nav-back" onclick="window.goToHome()">← На главную</button>
  <section class="hero">
    <div class="eyebrow">Конструктор</div>
    <h1>Создать тест</h1>
    <p class="sub">Составь задания, укажи правильные ответы и отправь тест ученикам через QR-код или ссылку.</p>
  </section>

  <section class="card">
    <label class="creator-label">Название теста</label>
    <input class="creator-input" id="testTitle" maxlength="100" placeholder="Например: Контрольная по математике">

    <label class="creator-label">Описание</label>
    <textarea class="creator-textarea" id="testDescription" maxlength="300" placeholder="Дополнительная информация (необязательно)"></textarea>

    <div class="section-title" style="margin-top:4px">Вопросы</div>
    <div id="questionEditors"></div>

    <button type="button" class="secondary" style="width:100%;margin-top:10px" onclick="window.addQuestion()">＋ Добавить вопрос</button>
    <button type="button" class="primary" style="width:100%;margin-top:10px" onclick="window.publishTest()">Создать ссылку и QR-код</button>
    <p class="creator-error" id="creatorError"></p>
  </section>

  <section class="card" id="shareResult" style="display:none">
    <h2 style="margin:0 0 6px;font-size:19px">🎉 Тест готов</h2>
    <p class="muted" style="margin:0 0 8px">Покажи QR-код ученикам или отправь им ссылку.</p>
    <div class="qr-wrap">
      <div id="qrcode"></div>
      <strong>Отсканируй камерой телефона</strong>
    </div>
    <label class="creator-label">Ссылка на тест</label>
    <div class="share-url" id="shareUrl"></div>
    <button type="button" class="primary" style="width:100%" onclick="window.copyLink()">Скопировать ссылку</button>
    <p class="muted" style="margin-top:10px">Тест передаётся прямо в ссылке. Для работы на разных устройствах сайт должен быть опубликован в интернете.</p>
  </section>
</div>

<div id="screenStudent" class="screen hidden">
  <button type="button" class="nav-back" onclick="window.goToHome()">← На главную</button>
  <section class="hero">
    <div class="eyebrow">Тест по ссылке</div>
    <h1 id="studentTitle">Тест</h1>
    <p class="sub" id="studentDescription"></p>
    <p class="muted" id="studentCount"></p>
  </section>
  <section class="card">
    <div id="studentQuestions"></div>
    <button type="button" class="primary" style="width:100%;margin-top:15px" id="submitStudent">Завершить тест</button>
    <div class="result" id="studentResult"></div>
  </section>
</div>

<div class="footer-container">
  <p class="note">EduStep · Учебный проект. Все задания генерируются из базы знаний. Сайт адаптирован для смартфона и ПК.</p>
  <div class="author-credits">Жуков Максим 9Д</div>
</div>
</div>

<script>
function formatText(str) {
  if (!str) return '';
  return String(str).replace(/\b(\d+)\/(\d+)\b/g, '<span class="frac"><span class="num">$1</span><span class="den">$2</span></span>');
}

function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }

function shuffle(array) {
  let arr = array.slice();
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

/* ===================== БЕЗОПАСНЫЙ localStorage ===================== */
function safeGetCompleted(){
  try { return Number(localStorage.getItem('edustep_completed') || 0); }
  catch(e){ return 0; }
}
function safeSetCompleted(v){
  try { localStorage.setItem('edustep_completed', v); } catch(e){}
}

/* ===================== ГЕНЕРАТОРЫ ЗАДАНИЙ (РАСШИРЕННЫЕ) ===================== */
const taskGenerators = {
  /* ---------- МАТЕМАТИКА 1 КЛАСС ---------- */
  'm1_1': () => {
    const pool = [];
    for(let i=0; i<80; i++) { let a = rand(2, 15), b = rand(1, 8); pool.push([`Сколько будет ${a} + ${b}?`, a+b, `Прибавь к ${a} сначала недостающее до 10, а затем остаток.`, `${a} + ${b} = ${a+b}.`]); }
    for(let i=0; i<80; i++) { let a = rand(8, 20), b = rand(1, 9); if(a - b < 0) continue; pool.push([`Вычисли: ${a} − ${b}`, a-b, `Уменьши число пошагово.`, `${a} − ${b} = ${a-b}.`]); }
    for(let i=0; i<60; i++) { let a = rand(2, 9), b = rand(1, 6), c = rand(1, 5); pool.push([`Вычисли цепочку: ${a} + ${b} + ${c}`, a+b+c, `Сложи числа по порядку слева направо.`, `${a} + ${b} + ${c} = ${a+b+c}.`]); }
