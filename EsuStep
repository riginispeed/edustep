};

function escapeHTML(value){
  return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
}

function renderEditors(){
  $('questionEditors').innerHTML = editorQuestions.map((q,i)=>`
    <div class="q-editor" data-index="${i}">
      <div class="q-head">
        <strong>Вопрос ${i+1}</strong>
        <button type="button" class="q-danger" onclick="window.removeQuestion(${i})">Удалить</button>
      </div>
      <label class="creator-label">Текст вопроса</label>
      <textarea class="creator-textarea q-text" maxlength="500" placeholder="Напиши вопрос">${escapeHTML(q.text)}</textarea>
      <label class="creator-label">Тип ответа</label>
      <select class="creator-select q-type" onchange="window.changeType(${i},this.value)">
        <option value="choice" ${q.type==='choice'?'selected':''}>Выбор варианта</option>
        <option value="text" ${q.type==='text'?'selected':''}>Ввод ответа</option>
      </select>
      ${q.type==='choice'?`
        <label class="creator-label">Варианты ответов</label>
        <div class="q-options">
          ${q.options.map((v,j)=>`
            <input class="creator-input q-option" data-option="${j}" maxlength="160" placeholder="Вариант ${j+1}" value="${escapeHTML(v)}">
          `).join('')}
        </div>
        <label class="creator-label">Правильный вариант</label>
        <select class="creator-select q-correct">
          ${q.options.map((v,j)=>`<option value="${j}" ${q.correct===j?'selected':''}>Вариант ${j+1}</option>`).join('')}
        </select>
      `:`
        <label class="creator-label">Правильный ответ</label>
        <input class="creator-input q-answer" maxlength="160" placeholder="Например: 42" value="${escapeHTML(q.answer)}">
      `}
    </div>
  `).join('');
}

function readEditors(){
  document.querySelectorAll('.q-editor').forEach(el=>{
    const i = Number(el.dataset.index);
    const q = editorQuestions[i];
    q.text = el.querySelector('.q-text').value.trim();
    q.type = el.querySelector('.q-type').value;
    if (q.type==='choice'){
      q.options = [...el.querySelectorAll('.q-option')].map(x=>x.value.trim());
      q.correct = Number(el.querySelector('.q-correct').value);
    } else {
      q.answer = el.querySelector('.q-answer').value.trim();
    }
  });
}

window.changeType = function(index, type){
  readEditors();
  editorQuestions[index].type = type;
  renderEditors();
};

window.removeQuestion = function(index){
  readEditors();
  editorQuestions.splice(index,1);
  renderEditors();
};

window.publishTest = function(){
  readEditors();
  const title = $('testTitle').value.trim();
  const description = $('testDescription').value.trim();

  if(!title){ $('creatorError').textContent = 'Укажи название теста.'; return; }
  if(editorQuestions.length === 0){ $('creatorError').textContent = 'Добавь хотя бы один вопрос.'; return; }

  for(let i=0;i<editorQuestions.length;i++){
    const q = editorQuestions[i];
    if(!q.text){ $('creatorError').textContent = `Заполни вопрос №${i+1}.`; return; }
    if(q.type==='choice'){
      if(q.options.filter(Boolean).length < 2){ $('creatorError').textContent = `В вопросе №${i+1} нужно минимум два варианта.`; return; }
      if(!q.options[q.correct]){ $('creatorError').textContent = `Выбери правильный вариант в вопросе №${i+1}.`; return; }
    } else if(!q.answer){
      $('creatorError').textContent = `Укажи правильный ответ в вопросе №${i+1}.`; return;
    }
  }

  const data = {
    v:1, t:title, d:description,
    q: editorQuestions.map(q => q.type==='choice'
      ? {t:q.text, o:q.options.filter(Boolean), c:q.options.filter(Boolean).indexOf(q.options[q.correct])}
      : {t:q.text, a:q.answer})
  };

  let encoded;
  try {
    encoded = btoa(unescape(encodeURIComponent(JSON.stringify(data))))
      .replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
  } catch(e){
    $('creatorError').textContent = 'Ошибка подготовки теста.'; return;
  }

  const url = location.href.split('#')[0] + '#quiz=' + encoded;
  if(url.length > 2000){
    $('creatorError').textContent = 'Слишком длинная ссылка. Попробуй сократить тест.'; return;
  }

  $('shareUrl').textContent = url;
  $('shareResult').style.display = 'block';
  $('creatorError').textContent = '';
  $('qrcode').innerHTML = '';

  if(typeof QRCode !== 'undefined'){
    try {
      new QRCode($('qrcode'), { text:url, width:220, height:220, colorDark:'#111111', colorLight:'#ffffff', correctLevel:QRCode.CorrectLevel.M });
    } catch(e){
      $('qrcode').textContent = 'Не удалось создать QR-код. Используй ссылку ниже.';
    }
  } else {
    $('qrcode').textContent = 'QR-библиотека не загрузилась. Используй ссылку ниже.';
  }
  $('shareResult').scrollIntoView({behavior:'smooth'});
};

window.copyLink = async function(){
  const url = $('shareUrl').textContent;
  try {
    await navigator.clipboard.writeText(url);
    alert('Ссылка скопирована!');
  } catch(e){
    alert('Не удалось скопировать. Выдели ссылку вручную.');
  }
};

/* ===================== ПРОХОЖДЕНИЕ ТЕСТА ПО ССЫЛКЕ ===================== */
function loadSharedQuiz(){
  if(!location.hash.startsWith('#quiz=')) return false;
  try {
    const raw = location.hash.slice(6).replace(/-/g,'+').replace(/_/g,'/');
    const data = JSON.parse(decodeURIComponent(escape(atob(raw))));
    if(data.v!==1 || !data.t || !Array.isArray(data.q) || !data.q.length || data.q.length>30) throw Error('invalid');

    $('studentTitle').textContent = data.t;
    $('studentDescription').textContent = data.d || 'Ответь на вопросы и заверши тест.';
    $('studentCount').textContent = 'Количество вопросов: ' + data.q.length;

    $('studentQuestions').innerHTML = data.q.map((q,i)=>`
      <div class="q-editor">
        <strong>${i+1}. ${escapeHTML(q.t)}</strong>
        ${Array.isArray(q.o)
          ? q.o.map((option,j)=>`
            <div class="student-option">
              <input type="radio" name="student${i}" id="sq${i}_${j}" value="${j}">
              <label for="sq${i}_${j}">${escapeHTML(option)}</label>
            </div>
          `).join('')
          : `<input class="student-text" id="studentText${i}" placeholder="Твой ответ">`
        }
      </div>
    `).join('');

    $('studentResult').classList.remove('show');
    $('submitStudent').disabled = false;
    $('submitStudent').textContent = 'Завершить тест';

    $('submitStudent').onclick = () => {
      let score = 0;
      data.q.forEach((q,i)=>{
        let correct = false;
        if(Array.isArray(q.o)){
          const selected = document.querySelector(`input[name="student${i}"]:checked`);
          correct = !!selected && Number(selected.value) === q.c;
        } else {
          const value = $('studentText'+i).value.trim().toLowerCase();
          correct = value !== '' && value.replace(/\s+/g,'') === String(q.a).trim().toLowerCase().replace(/\s+/g,'');
        }
        if(correct) score++;
      });

      const percent = Math.round(score/data.q.length*100);
      const box = $('studentResult');
      box.innerHTML = `
        <div class="lesson-head"><strong>${score} из ${data.q.length}</strong><span class="pill">${percent}%</span></div>
        <p>${percent===100?'Отлично! Все ответы правильные':percent>=60?'Хороший результат!':'Попробуй повторить материал.'}</p>
      `;
      box.classList.add('show');
      $('submitStudent').disabled = true;
      $('submitStudent').textContent = 'Тест завершён';

      if(percent === 100){
        state.completedTests++;
        updateUserUI();
      }
    };

    showScreen('screenStudent');
    return true;
  } catch(e){
    alert('Ссылка повреждена или тест не удалось открыть.');
    history.replaceState(null,'',location.pathname+location.search);
    return false;
  }
}

function setupEventListeners() {
  $('homeLogo').onclick = window.goToHome;

  $('theoryToggleBtn').onclick = () => {
    const dropdown = $('theoryDropdown');
    const isOpen = dropdown.classList.contains('open');
    if (isOpen) {
      dropdown.classList.remove('open');
      $('theoryToggleBtn').textContent = 'Подробнее (Теория и правила)';
    } else {
      dropdown.classList.add('open');
      $('theoryToggleBtn').textContent = 'Скрыть теорию';
    }
  };

  $('checkBtn').onclick = () => {
    const tasks = state.currentTasks;
    let correct = 0, filled = 0;
    tasks.forEach((t,i)=>{
      const input = $('answer'+i);
      const feedback = $('feedback'+i);
      const value = normalize(input.value);
      const expected = normalize(t[1]);
      input.classList.remove('correct','wrong');
      feedback.className = 'feedback';
      if(value !== '') filled++;
      if(value !== '' && value === expected){
        correct++;
        input.classList.add('correct');
        feedback.classList.add('good');
        feedback.innerHTML = 'Правильно! ' + formatText(t[3]);
      } else {
        input.classList.add('wrong');
        feedback.classList.add('bad');
        feedback.innerHTML = (value === '' ? 'Введите ответ. ' : 'Пока неверно. ') + 'Подсказка: ' + formatText(t[2]) + ' Правильный ответ: ' + formatText(String(t[1])) + '.';
      }
    });
    const total = tasks.length;
    const percent = Math.round(correct/total*100);
    $('score').textContent = correct + ' из ' + total;
    $('percent').textContent = percent + '%';
    if (percent === 100 && filled === total){
      state.completedTests++;
      updateUserUI();
    }
    if (filled === total){
      state.isTestCompleted = true;
    }
    $('resultText').textContent = filled < total
      ? 'Заполнено ' + filled + ' из ' + total + ' заданий. Исправьте ответы и проверьте ещё раз.'
      : percent === 100
        ? 'Отличная работа! Все ответы правильные'
        : percent >= 60
          ? 'Хороший результат! Прочитайте объяснения ошибок и попробуйте ещё раз.'
          : 'Не сдавайтесь! Повторите правило и попробуйте решить задания ещё раз.';
    $('result').classList.add('show');
    $('progressBar').style.width = percent + '%';
  };

  $('resetBtn').onclick = () => {
    generateAndRenderLesson();
  };
}

document.addEventListener('DOMContentLoaded', () => {
  updateUserUI();
  setupEventListeners();
  if(!loadSharedQuiz()) window.goToHome();
});
</script>
