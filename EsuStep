let state = {
  subject: null, grade: null, topic: null,
  currentTasks: [],
  completedTests: safeGetCompleted(),
  isTestCompleted: false
};

const $ = id => document.getElementById(id);

function updateUserUI() {
  $('userBadge').textContent = `Пройдено тестов: ${state.completedTests}`;
  safeSetCompleted(state.completedTests);
}

window.goToHome = function() {
  state.subject = null; state.grade = null; state.topic = null; state.isTestCompleted = false;
  showScreen('screenHome');
};

window.selectSubject = function(subKey) {
  state.subject = subKey;
  $('gradesHeroSub').textContent = curriculum[subKey].name;
  showScreen('screenGrades');
};

window.goToGrades = function() {
  state.grade = null; state.topic = null; state.isTestCompleted = false;
  showScreen('screenGrades');
};

window.selectGrade = function(gradeNum) {
  state.grade = gradeNum;
  $('topicsHeroSub').textContent = `${curriculum[state.subject].name} · ${gradeNum} класс`;
  renderTopics();
  showScreen('screenTopics');
};

window.goToTopics = function() {
  state.topic = null; state.isTestCompleted = false;
  showScreen('screenTopics');
};

function showScreen(screenId) {
  ['screenHome','screenGrades','screenTopics','screenLesson','screenCreator','screenStudent'].forEach(id => {
    const el = $(id);
    if (id === screenId) el.classList.remove('hidden');
    else el.classList.add('hidden');
  });
  window.scrollTo({top:0, behavior:'smooth'});
}

function renderTopics() {
  const topics = curriculum[state.subject][state.grade];
  $('topicListContainer').innerHTML = topics.map((t, i) => `
    <button type="button" class="topic-btn" onclick="window.selectTopic(${i})">
      <div class="topic-info">
        <span class="topic-number">Тема ${i+1}</span>
        <strong>${t.title}</strong>
      </div>
      <div class="topic-arrow">→</div>
    </button>
  `).join('');
}

window.selectTopic = function(topicIndex) {
  state.topic = topicIndex;
  state.isTestCompleted = false;
  generateAndRenderLesson();
  showScreen('screenLesson');
};

function normalize(v) {
  return String(v).trim().toLowerCase()
    .replace(/\s+/g, '')
    .replace(/,/g, '.')
    .replace(/−/g, '-')
    .replace(/⁄/g, '/')
    .replace(/\\/g, '');
}

function generateAndRenderLesson() {
  const lessonInfo = curriculum[state.subject][state.grade][state.topic];
  state.currentTasks = generateTestTasks(state.subject, state.grade, state.topic);
  state.isTestCompleted = false;
  $('theoryDropdown').classList.remove('open');
  $('theoryToggleBtn').textContent = 'Подробнее (Теория и правила)';
  $('gradeLabel').textContent = `${state.grade} класс · ${curriculum[state.subject].name}`;
  $('countLabel').textContent = state.currentTasks.length + ' заданий';
  $('topicTitle').textContent = lessonInfo.title;
  $('theory').innerHTML = formatText(lessonInfo.theory);
  $('example').innerHTML = formatText(lessonInfo.example);
  $('tasks').innerHTML = state.currentTasks.map((t, i) => `
    <div class="task">
      <div class="task-head">
        <div class="num">${i+1}</div>
        <div class="question">${formatText(t[0])}</div>
      </div>
      <div class="answer">
        <input type="text" inputmode="text" autocomplete="off" id="answer${i}" placeholder="Твой ответ" aria-label="Ответ на задание ${i+1}">
      </div>
      <div class="feedback" id="feedback${i}"></div>
    </div>
  `).join('');
  $('result').classList.remove('show');
  $('progressBar').style.width = '0%';
  $('checkBtn').textContent = 'Проверить ответы';
  $('resetBtn').disabled = false;
  $('resetBtn').textContent = '🔄 Новые задания (Сброс)';
}

